// DROP INTO: brave/components/browse_here/common/browse_here.mojom

module brave_browse_here.mojom;

// Represents a detected video source from a webpage.
struct VideoSource {
  string url;
  string type;    // "mp4", "hls", "dash", "webm", "iframe", "unknown"
  string title;
  string? quality;
  double? duration;
  string? thumbnail;
  string source_host;
};

// Represents a saved playlist entry persisted by BrowseHereService.
struct PlaylistEntry {
  int32 id;
  string url;
  string type;
  string title;
  string? quality;
  double? duration;
  string? thumbnail;
  string source_host;
  string added_at;  // ISO 8601 UTC
};

// ---------------------------------------------------------
// Renderer → Browser: renderer scanner calls this
// ---------------------------------------------------------
// Implemented in the browser process by BrowseHereService.
// Bound via GetBrowserInterfaceBroker in BrowseHereRenderFrameObserver.
interface BrowseHereHost {
  // Called when the renderer scanner finds video sources on the current page.
  OnVideosDetected(array<VideoSource> videos,
                   string page_title,
                   string page_url);
};

// ---------------------------------------------------------
// Browser → WebUI page: events pushed to chrome://browse-here
// ---------------------------------------------------------
// Implemented in the frontend by BrowseHerePageCallbackRouter (generated).
interface BrowseHerePage {
  // Fired whenever the active tab's scanner reports new videos.
  OnVideosDetected(array<VideoSource> videos,
                   string page_title,
                   string page_url);
};

// ---------------------------------------------------------
// WebUI page → Browser: chrome://browse-here calls this
// ---------------------------------------------------------
// Implemented in the browser process by BrowseHereUI.
interface BrowseHerePageHandler {
  // Supply the page remote so the browser can push events to the WebUI.
  SetPage(pending_remote<BrowseHerePage> page);

  // Fetch saved playlist entries from disk.
  GetPlaylist() => (array<PlaylistEntry> entries);

  // Add a video to the persistent playlist.
  AddToPlaylist(VideoSource video) => (PlaylistEntry entry);

  // Remove an entry by ID.
  RemoveFromPlaylist(int32 id) => (bool success);

  // Get the most recently detected videos from the active tab.
  GetDetectedVideos() => (array<VideoSource> videos, string page_title);

  // Trigger a fresh DOM scan on the active tab.
  ScanCurrentPage();
};
